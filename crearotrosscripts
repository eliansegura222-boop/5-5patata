local function GetPanelObject(guiName, childName)
    local registry = SharedState.UnifiedObjects
    if registry and registry[guiName] and registry[guiName][childName] then
        local obj = registry[guiName][childName]
        if obj and obj.Parent then return obj end
    end
    local gui = PlayerGui:FindFirstChild(guiName)
    return gui and gui:FindFirstChild(childName) or nil
end
