-- ============================================================
-- SPEED ENGINE (fixed): horizontal LinearVelocity from MoveDirection
-- - OFF in air / jump / freefall  => no floating
-- - moderate XZ force only       => no slam when stepping on parts
-- - Y force always 0
-- ============================================================
local _speedAtt, _speedLV, _speedCharRef = nil, nil, nil
local _speedWasAirborne = false

local function destroySpeedLV()
if _speedLV then pcall(function() _speedLV:Destroy() end); _speedLV = nil end
if _speedAtt then pcall(function() _speedAtt:Destroy() end); _speedAtt = nil end
_speedCharRef = nil
end

local function ensureSpeedLV(hrp)
if not hrp then return nil end
if _speedCharRef == hrp.Parent and _speedLV and _speedLV.Parent and _speedAtt and _speedAtt.Parent then
return _speedLV
end
destroySpeedLV()
local att = Instance.new("Attachment")
att.Name = "DreamSpeedAtt"
att.Parent = hrp
local lv = Instance.new("LinearVelocity")
lv.Name = "DreamSpeedLV"
lv.Attachment0 = att
lv.RelativeTo = Enum.ActuatorRelativeTo.World
lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
pcall(function()
lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
end)
-- Start disabled; enable only when grounded + moving
lv.MaxAxesForce = Vector3.new(0, 0, 0)
lv.VectorVelocity = Vector3.zero
lv.Enabled = false
lv.Parent = hrp
_speedAtt = att
_speedLV = lv
_speedCharRef = hrp.Parent
return lv
end

local function disableSpeedLV()
if not _speedLV then return end
_speedLV.Enabled = false
_speedLV.VectorVelocity = Vector3.zero
_speedLV.MaxAxesForce = Vector3.new(0, 0, 0)
end

local function isAirborne(hum, hrp)
if not hum then return true end
local st = hum:GetState()
if hum.PlatformStand then return true end
if st == Enum.HumanoidStateType.Jumping
or st == Enum.HumanoidStateType.Freefall
or st == Enum.HumanoidStateType.Physics
or st == Enum.HumanoidStateType.Ragdoll
or st == Enum.HumanoidStateType.FallingDown
or st == Enum.HumanoidStateType.Flying then
return true
end
-- FloorMaterial is the most reliable grounded check
if hum.FloorMaterial == Enum.Material.Air then
return true
end
return false
end

local function applyGroundSpeed(hrp, hum, md, spd)
local lv = ensureSpeedLV(hrp)
if not lv then return end

local dir = Vector3.new(md.X, 0, md.Z)
if dir.Magnitude < 0.05 then
disableSpeedLV()
return
end
dir = dir.Unit

-- Soft force scaled by mass + speed (huge forces = slam/float on contact)
local mass = 1
pcall(function() mass = hrp.AssemblyMass or hrp:GetMass() or 1 end)
if mass < 1 then mass = 1 end
local maxF = math.clamp(mass * math.max(spd, 16) * 42, 10000, 90000)

lv.MaxAxesForce = Vector3.new(maxF, 0, maxF) -- Y always 0
lv.VectorVelocity = Vector3.new(dir.X * spd, 0, dir.Z * spd)
lv.Enabled = true
end

RunService.Heartbeat:Connect(function()
local char = LP.Character
if not char then
destroySpeedLV()
return
end
local hum = char:FindFirstChildOfClass("Humanoid")
local hrp = char:FindFirstChild("HumanoidRootPart")
if not hum or not hrp then
destroySpeedLV()
return
end

local airborne = isAirborne(hum, hrp)
local md = hum.MoveDirection
local spd = getCurrentSpeedValue()

-- Other movement systems own the character
if autoLeftEnabled or autoRightEnabled then
disableSpeedLV()
_speedWasAirborne = airborne
-- overhead still updates below
else
if md.Magnitude > 0.05 then
-- Keep horizontal speed on ground AND in air (Y force stays 0 => no float)
if airborne then
_speedWasAirborne = true
elseif _speedWasAirborne then
_speedWasAirborne = false
local v = hrp.AssemblyLinearVelocity
if v.Y < -2 then
hrp.AssemblyLinearVelocity = Vector3.new(v.X * 0.9, math.max(v.Y, -14), v.Z * 0.9)
end
end
lastMoveDir = md
applyGroundSpeed(hrp, hum, md, spd)
else
-- No move input: release LV (in air keep residual momentum, on ground stop push)
disableSpeedLV()
if not airborne then
_speedWasAirborne = false
else
_speedWasAirborne = true
end
end
end

if overheadSpeedLabel then
local v = hrp.AssemblyLinearVelocity or Vector3.zero
local speedMag = Vector3.new(v.X, 0, v.Z).Magnitude
local rounded = math.floor(speedMag * 10 + 0.5) / 10
if math.abs(rounded - math.floor(rounded)) < 0.05 then
overheadSpeedLabel.Text = string.format("Speed: %d", math.floor(rounded + 0.5))
else
overheadSpeedLabel.Text = string.format("Speed: %.1f", rounded)
end
end
end)

