        if loaded[name] then
            setStatus(name .. " is already loaded")
            return true
        end
        local source = MODULES[name]
        if type(source) ~= "string" or source == "" then
            setStatus("Missing source: " .. tostring(name), false)
            return false
        end
        local fn, compileErr = loadstring(source)
        if not fn then
            warn("[H4SK ALL-IN-ONE] Compile error in "..name..": "..tostring(compileErr))
            setStatus("Compile error: " .. name, false)
            return false
        end
        local ok, runtimeErr = pcall(fn)
        if not ok then
            warn("[H4SK ALL-IN-ONE] Runtime error in "..name..": "..tostring(runtimeErr))
            setStatus("Runtime error: " .. name, false)
            return false
        end
        loaded[name] = true
