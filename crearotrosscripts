-- [UNIFIED/PERF PATCH] FPS boost must NEVER touch player characters.
-- The previous version destroyed accessories/textures and changed player parts while
-- scanning the entire Workspace, which could make other players look frozen/broken.
local FPSBoostState = {
    descendantConn = nil,
    originals = setmetatable({}, {__mode = "k"}),
    lighting = nil,
}

local function getPlayerCharacterAncestor(obj)
    local model = obj and obj:FindFirstAncestorOfClass("Model")
    if model and Players:GetPlayerFromCharacter(model) then
        return model
    end
    return nil
end

local function rememberFPSObject(obj, data)
    if not FPSBoostState.originals[obj] then
        FPSBoostState.originals[obj] = data
    end
end

local function stripVisuals(obj)
    if not obj or getPlayerCharacterAncestor(obj) then return end

    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or
       obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or
       obj:IsA("Highlight") then
        rememberFPSObject(obj, {kind = "Enabled", value = obj.Enabled})
        obj.Enabled = false
        return
    end

    if obj:IsA("BasePart") then
        local data = {
            kind = "BasePart",
            Material = obj.Material,
            Reflectance = obj.Reflectance,
            CastShadow = obj.CastShadow,
        }
        if obj:IsA("MeshPart") then data.TextureID = obj.TextureID end
        rememberFPSObject(obj, data)
        obj.Material = Enum.Material.Plastic
        obj.Reflectance = 0
        obj.CastShadow = false
        if obj:IsA("MeshPart") then obj.TextureID = "" end
        return
    end

    if obj:IsA("Decal") or obj:IsA("Texture") then
        rememberFPSObject(obj, {kind = "Transparency", value = obj.Transparency})
        obj.Transparency = 1
        return
    end
end

local function restoreFPSBoostVisuals()
    for obj, data in pairs(FPSBoostState.originals) do
        if obj and obj.Parent and data then
            pcall(function()
                if data.kind == "Enabled" then
                    obj.Enabled = data.value
                elseif data.kind == "Transparency" then
                    obj.Transparency = data.value
                elseif data.kind == "BasePart" and obj:IsA("BasePart") then
                    obj.Material = data.Material
                    obj.Reflectance = data.Reflectance
                    obj.CastShadow = data.CastShadow
                    if data.TextureID ~= nil and obj:IsA("MeshPart") then
                        obj.TextureID = data.TextureID
                    end
                end
            end)
        end
    end
    FPSBoostState.originals = setmetatable({}, {__mode = "k"})

    if FPSBoostState.lighting then
        pcall(function()
            Lighting.GlobalShadows = FPSBoostState.lighting.GlobalShadows
            Lighting.FogEnd = FPSBoostState.lighting.FogEnd
            Lighting.FogStart = FPSBoostState.lighting.FogStart
            Lighting.EnvironmentDiffuseScale = FPSBoostState.lighting.EnvironmentDiffuseScale
            Lighting.EnvironmentSpecularScale = FPSBoostState.lighting.EnvironmentSpecularScale
        end)
        FPSBoostState.lighting = nil
    end
end

local function setFPSBoost(enabled)
    Config.FPSBoost = enabled == true
    SaveConfig()

    if FPSBoostState.descendantConn then
        FPSBoostState.descendantConn:Disconnect()
        FPSBoostState.descendantConn = nil
    end

    if not Config.FPSBoost then
        restoreFPSBoostVisuals()
        return
    end

    FPSBoostState.lighting = FPSBoostState.lighting or {
        GlobalShadows = Lighting.GlobalShadows,
        FogEnd = Lighting.FogEnd,
        FogStart = Lighting.FogStart,
        EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
        EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
    }

    Lighting.GlobalShadows = false
    Lighting.FogEnd = 1000000
    Lighting.FogStart = 0
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0

    -- Disable post effects instead of destroying them, so turning FPS Boost off is safe.
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect") or
           v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") then
            rememberFPSObject(v, {kind = "Enabled", value = v.Enabled})
            v.Enabled = false
        end
    end

    -- Yield during the first scan so execution does not freeze for one huge frame.
    local descendants = Workspace:GetDescendants()
    for i = 1, #descendants do
        stripVisuals(descendants[i])
        if i % 350 == 0 then task.wait() end
    end

    FPSBoostState.descendantConn = Workspace.DescendantAdded:Connect(function(obj)
        if Config.FPSBoost then
            task.defer(stripVisuals, obj)
        end
    end)
end

