        -- Some games toggle the inner frame's Visible instead of the SG's Enabled
        local inner = indexSG:FindFirstChild("Index")
        if inner then
            inner:GetPropertyChangedSignal("Visible"):Connect(function()
                if inner.Visible then
                    for i = 1, 6 do
