                    version            = 1,
                    autoRestore        = autoRestoreEnabled,
                    autoSave           = autoSaveEnabled,
                    webhook            = webhookEnabled,
                    toggleKey          = toggleKeyName,
                    rejoinKey          = rejoinKeyName,
