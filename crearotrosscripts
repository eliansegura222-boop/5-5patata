    local gradient = Instance.new("UIGradient")
    gradient.Color = dark and RUBY_DARK_SEQUENCE or RUBY_SEQUENCE
    gradient.Rotation = 0
    gradient.Parent = parent
    RUBY_GRADIENTS[#RUBY_GRADIENTS + 1] = gradient
    return gradient
end

